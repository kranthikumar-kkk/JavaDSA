class Node{
    int data;
    Node left,right;
    public Node(int data){
        this.data=data;
        this.left=null;
        this.right=null;
    }
}
public class Main{
    static Node root;
    public static void main(String[]args){
        root=new Node(7);
        Node left=new Node(5);
        Node right=new Node(9);
        root.left=left;
        root.right=right;
        Node leftx=new Node(7);
        Node rightx=new Node(6);
        Node lefty=new Node(8);
        Node righty=new Node(10);
        root.left.left=leftx;
        root.left.right=rightx;
        root.right.left=lefty;
        root.right.right=righty;
        postorder(root);
    }
    public static void postorder(Node root){
        if(root==null)return;
        postorder(root.left);
        postorder(root.right);
        System.out.println(root.data+" ");
    }
}
